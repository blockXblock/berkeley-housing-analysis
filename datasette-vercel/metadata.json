{
  "title": "Berkeley Housing Projects Interactive Map",
  "description": "70 housing development projects mapped in Berkeley, CA",
  "source": "City of Berkeley Planning Department",
  "source_url": "https://www.cityofberkeley.info/planning/",
  "databases": {
    "berkeley_housing_map": {
      "title": "Berkeley Housing Pipeline",
      "tables": {
        "projects": {
          "title": "All Projects (70 mapped)",
          "description": "Housing projects with coordinates - 6,363 total units",
          "sort_desc": "net_units",
          "plugins": {
            "datasette-cluster-map": {
              "latitude_column": "latitude",
              "longitude_column": "longitude"
            }
          },
          "facets": [
            "year",
            "project_size_category"
          ]
        },
        "map_view": {
          "title": "\ud83d\udccd MAP VIEW - Click Here!",
          "description": "Optimized view for mapping with popups",
          "plugins": {
            "datasette-cluster-map": {
              "latitude_column": "latitude",
              "longitude_column": "longitude",
              "popup_template": "\n                                <div style=\"min-width: 250px; max-width: 400px;\">\n                                    <h3 style=\"margin: 0 0 10px 0; color: #2c3e50;\">\n                                        {{ address_display }}\n                                    </h3>\n                                    <p style=\"margin: 5px 0; font-size: 18px; font-weight: bold;\">\n                                        {{ size_emoji }} <span style=\"color: #27ae60;\">{{ net_units }} units</span>\n                                    </p>\n                                    <p style=\"margin: 5px 0;\">\n                                        <strong>Year:</strong> {{ year }}<br>\n                                        <strong>Status:</strong> {{ status }}<br>\n                                        <strong>Permit:</strong> {{ permits }}\n                                    </p>\n                                    {% if description_short %}\n                                    <p style=\"margin: 10px 0 0 0; font-size: 0.9em; color: #555;\">\n                                        {{ description_short }}...\n                                    </p>\n                                    {% endif %}\n                                </div>\n                            "
            }
          }
        }
      }
    }
  }
}