<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2">
  <Document>
    <name>Berkeley Housing Pipeline - Longer Corridors Tour</name>
    <open>1</open>
    <gx:Tour>
      <name>Berkeley Housing Pipeline - Longer Corridors Tour</name>
      <gx:Playlist>

        <gx:FlyTo><gx:duration>7</gx:duration><gx:flyToMode>bounce</gx:flyToMode><Camera>
          <longitude>-122.2733</longitude><latitude>37.8700</latitude><altitude>240</altitude>
          <heading>88</heading><tilt>80</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>5</gx:duration></gx:Wait>

        <gx:FlyTo><gx:duration>6</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.2618</longitude><latitude>37.8654</latitude><altitude>210</altitude>
          <heading>118</heading><tilt>82</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:FlyTo><gx:duration>5</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.2598</longitude><latitude>37.8656</latitude><altitude>205</altitude>
          <heading>180</heading><tilt>82</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:FlyTo><gx:duration>5</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.2598</longitude><latitude>37.8656</latitude><altitude>205</altitude>
          <heading>320</heading><tilt>82</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>6</gx:duration></gx:Wait>

        <!-- Shattuck corridor shifted east and lengthened -->
        <gx:FlyTo><gx:duration>6</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.263429</longitude><latitude>37.849308</latitude><altitude>182.88</altitude>
          <heading>338</heading><tilt>80</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:FlyTo><gx:duration>10</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.263229</longitude><latitude>37.860700</latitude><altitude>182.88</altitude>
          <heading>350</heading><tilt>80</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:FlyTo><gx:duration>12</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.262729</longitude><latitude>37.881692</latitude><altitude>182.88</altitude>
          <heading>2</heading><tilt>79</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:FlyTo><gx:duration>5</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.262729</longitude><latitude>37.881692</latitude><altitude>182.88</altitude>
          <heading>182</heading><tilt>77</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>12</gx:duration></gx:Wait>

        <!-- Start west of University/San Pablo, hold 8s at intersection, then east along University shifted south -->
        <gx:FlyTo><gx:duration>6</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.288000</longitude><latitude>37.868005</latitude><altitude>195</altitude>
          <heading>88</heading><tilt>81</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:FlyTo><gx:duration>4</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.285000</longitude><latitude>37.868005</latitude><altitude>195</altitude>
          <heading>88</heading><tilt>81</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>8</gx:duration></gx:Wait>
        <gx:FlyTo><gx:duration>6</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.280200</longitude><latitude>37.868005</latitude><altitude>195</altitude>
          <heading>88</heading><tilt>81</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>5</gx:duration></gx:Wait>
        <gx:FlyTo><gx:duration>6</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.275600</longitude><latitude>37.868005</latitude><altitude>195</altitude>
          <heading>88</heading><tilt>81</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>5</gx:duration></gx:Wait>
        <gx:FlyTo><gx:duration>6</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.270900</longitude><latitude>37.868005</latitude><altitude>195</altitude>
          <heading>88</heading><tilt>81</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>5</gx:duration></gx:Wait>
        <gx:FlyTo><gx:duration>6</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.267900</longitude><latitude>37.868005</latitude><altitude>195</altitude>
          <heading>88</heading><tilt>81</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>5</gx:duration></gx:Wait>
        <gx:FlyTo><gx:duration>6</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.264200</longitude><latitude>37.868005</latitude><altitude>195</altitude>
          <heading>88</heading><tilt>81</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>6</gx:duration></gx:Wait>

        <!-- San Pablo from south of Ashby to Virginia -->
        <gx:FlyTo><gx:duration>7</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.289200</longitude><latitude>37.852900</latitude><altitude>182.88</altitude>
          <heading>356</heading><tilt>80</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:FlyTo><gx:duration>12</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.285000</longitude><latitude>37.868000</latitude><altitude>182.88</altitude>
          <heading>358</heading><tilt>80</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>6</gx:duration></gx:Wait>
        <gx:FlyTo><gx:duration>10</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.284800</longitude><latitude>37.876900</latitude><altitude>182.88</altitude>
          <heading>2</heading><tilt>79</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>8</gx:duration></gx:Wait>

        <gx:FlyTo><gx:duration>8</gx:duration><gx:flyToMode>smooth</gx:flyToMode><Camera>
          <longitude>-122.2732</longitude><latitude>37.8700</latitude><altitude>210</altitude>
          <heading>90</heading><tilt>80</tilt><roll>0</roll><altitudeMode>absolute</altitudeMode>
        </Camera></gx:FlyTo>
        <gx:Wait><gx:duration>12</gx:duration></gx:Wait>

      </gx:Playlist>
    </gx:Tour>
  </Document>
</kml>
