<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2">
  <Document>
    <name>Berkeley Skyline Tour — Adeline-Shattuck Corridor</name>
    <description><![CDATA[
Route: Adeline & MacArthur → Shattuck/Adeline merge → Shattuck/University
Bookends: Open at Sather Tower (270° pan), close with 360° rotation downtown
Length: ~2:13
Altitude profile: 314m → 180m → 140m
Pace: contemplative
Best paired with: berkeley_skyline.kml (renders extruded buildings during flight)
Created: 2026-05-03
Last revised: 2026-05-03
Variants: none yet
Notes: Slow segment along Shattuck (30s) is the climactic showcase of tall projects.
    ]]></description>

    <gx:Tour>
      <name>Adeline-Shattuck Corridor Flyover</name>
      <description>
        ~135 second cinematic tour of Berkeley's south-to-downtown housing
        corridor. Press play in the Places sidebar to begin.
      </description>

      <gx:Playlist>

        <!-- ======================================================== -->
        <!-- SEGMENT 1: Opening — Campanile establishing shot         -->
        <!-- ======================================================== -->
        <!-- Sather Tower: 37.8721, -122.2578, top ~164m absolute     -->
        <!-- Camera: 150m above the tower top = 314m absolute alt     -->
        <!-- Initial heading: 135° (SE), tilt 65° (looking outward)   -->

        <gx:FlyTo>
          <gx:duration>4.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2578</longitude>
            <latitude>37.8721</latitude>
            <altitude>314</altitude>
            <heading>135</heading>
            <tilt>65</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:Wait>
          <gx:duration>2.0</gx:duration>
        </gx:Wait>

        <!-- ======================================================== -->
        <!-- SEGMENT 2: 270° clockwise pan (SE → S → W → N)           -->
        <!-- Camera holds position over Campanile, only heading rotates -->
        <!-- 270° / 25 sec = ~11°/sec — slow and contemplative         -->
        <!-- Implemented as 3 chained FlyTos to ensure clockwise direction -->
        <!-- (smooth mode interpolates the shorter arc by default;     -->
        <!--  intermediate waypoints force the long way around)         -->
        <!-- ======================================================== -->

        <!-- Pan from 135° (SE) to 225° (SW) -->
        <gx:FlyTo>
          <gx:duration>8.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2578</longitude>
            <latitude>37.8721</latitude>
            <altitude>314</altitude>
            <heading>225</heading>
            <tilt>65</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Pan from 225° (SW) to 315° (NW) -->
        <gx:FlyTo>
          <gx:duration>8.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2578</longitude>
            <latitude>37.8721</latitude>
            <altitude>314</altitude>
            <heading>315</heading>
            <tilt>65</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Pan from 315° (NW) to 45° (NE) — ends facing campus to the N/NE -->
        <gx:FlyTo>
          <gx:duration>8.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2578</longitude>
            <latitude>37.8721</latitude>
            <altitude>314</altitude>
            <heading>45</heading>
            <tilt>65</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:Wait>
          <gx:duration>2.0</gx:duration>
        </gx:Wait>

        <!-- ======================================================== -->
        <!-- SEGMENT 3: Fly to Adeline & MacArthur (south Berkeley)   -->
        <!-- Adeline & MacArthur: ~37.8395, -122.2659                 -->
        <!-- Distance from Campanile: ~3.6 km                         -->
        <!-- Descend from 314m to 180m during transit                 -->
        <!-- Heading: 220° (SW, pointing toward destination)          -->
        <!-- ======================================================== -->

        <gx:FlyTo>
          <gx:duration>20.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2659</longitude>
            <latitude>37.8395</latitude>
            <altitude>180</altitude>
            <heading>340</heading>
            <tilt>70</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:Wait>
          <gx:duration>1.5</gx:duration>
        </gx:Wait>

        <!-- ======================================================== -->
        <!-- SEGMENT 4: Fly north along Adeline centerline             -->
        <!-- Adeline runs ~340° (NNW) from MacArthur to Shattuck merge -->
        <!-- Endpoint: Adeline/Shattuck/MLK Jr Way confluence           -->
        <!--   ~37.8538, -122.2691                                     -->
        <!-- Distance: ~1.6 km, duration 25s for slow contemplative pace -->
        <!-- Altitude: hold ~180m so housing extrusions visible        -->
        <!-- Heading: 340° matches Adeline's true bearing              -->
        <!-- ======================================================== -->

        <gx:FlyTo>
          <gx:duration>25.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2691</longitude>
            <latitude>37.8538</latitude>
            <altitude>180</altitude>
            <heading>340</heading>
            <tilt>70</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:Wait>
          <gx:duration>1.5</gx:duration>
        </gx:Wait>

        <!-- ======================================================== -->
        <!-- SEGMENT 5: Turn at Shattuck/Adeline, head north on Shattuck -->
        <!-- Shattuck runs ~10° (slightly E of true N) per Berkeley    -->
        <!--   street grid                                             -->
        <!-- Endpoint: Shattuck & University ~37.8716, -122.2683       -->
        <!-- Distance: ~2.0 km                                         -->
        <!-- Duration 30s — climactic segment, most tall projects here -->
        <!-- ======================================================== -->

        <!-- First: a gentle turn at the intersection (3s reorientation) -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2691</longitude>
            <latitude>37.8538</latitude>
            <altitude>180</altitude>
            <heading>10</heading>
            <tilt>70</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- Then: fly north along Shattuck to University -->
        <gx:FlyTo>
          <gx:duration>30.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2683</longitude>
            <latitude>37.8716</latitude>
            <altitude>180</altitude>
            <heading>10</heading>
            <tilt>70</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:Wait>
          <gx:duration>1.5</gx:duration>
        </gx:Wait>

        <!-- ======================================================== -->
        <!-- SEGMENT 6: Final 360° rotation over Shattuck/University   -->
        <!-- Descend slightly to 140m for a more "in the city" feel    -->
        <!-- 360° / 25 sec ≈ 14°/sec — moderately slow                 -->
        <!-- 4 chained FlyTos at 6.25s each = full revolution          -->
        <!-- Tilt back from 70° to 60° for a slightly higher angle     -->
        <!-- ======================================================== -->

        <!-- Settle into the rotation start position -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2683</longitude>
            <latitude>37.8716</latitude>
            <altitude>140</altitude>
            <heading>10</heading>
            <tilt>60</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 0° to 90° (N to E) -->
        <gx:FlyTo>
          <gx:duration>6.25</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2683</longitude>
            <latitude>37.8716</latitude>
            <altitude>140</altitude>
            <heading>100</heading>
            <tilt>60</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 90° to 180° (E to S) -->
        <gx:FlyTo>
          <gx:duration>6.25</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2683</longitude>
            <latitude>37.8716</latitude>
            <altitude>140</altitude>
            <heading>190</heading>
            <tilt>60</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 180° to 270° (S to W) -->
        <gx:FlyTo>
          <gx:duration>6.25</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2683</longitude>
            <latitude>37.8716</latitude>
            <altitude>140</altitude>
            <heading>280</heading>
            <tilt>60</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 270° to 360°/10° (W back to N, full loop) -->
        <gx:FlyTo>
          <gx:duration>6.25</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2683</longitude>
            <latitude>37.8716</latitude>
            <altitude>140</altitude>
            <heading>10</heading>
            <tilt>60</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:Wait>
          <gx:duration>2.0</gx:duration>
        </gx:Wait>

      </gx:Playlist>
    </gx:Tour>
  </Document>
</kml>
