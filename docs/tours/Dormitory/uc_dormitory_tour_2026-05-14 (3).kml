<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2">
<Document>
  <name>UC Berkeley Dormitory Tour v4</name>
  <description>
    A tour of UC Berkeley's largest student housing projects.

    Opens 200m east of the Campanile (Sather Tower), looking west toward
    downtown Berkeley with the Campanile in the foreground. Then visits
    four major dormitory projects: 1950 Oxford, 2200 Bancroft, 2556
    Haste, and 2400 Bowditch (Anna Head).

    At each stop, the camera approaches the building from the east side
    (200m east) looking west, then orbits the structure clockwise at
    200m radius over 10 seconds (East -> South -> West -> North -> East).
    A 2-second pause follows each orbit.

    Final stop: 2400 Bowditch, camera pulls up 200ft and tilts nearly
    horizontal, looking west across Berkeley toward downtown.

    Total runtime ~75 seconds.
  </description>

  <gx:Tour>
    <name>UC Berkeley Dormitory Tour</name>
    <gx:Playlist>

      <!-- 1. Opening: 200m east of Campanile, looking west.
           Campanile (-122.2578, 37.8723) is the foreground subject;
           downtown Berkeley is the backdrop. -->
      <gx:FlyTo>
        <gx:duration>0</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2555</longitude>
          <latitude>37.8723</latitude>
          <altitude>120</altitude>
          <heading>270</heading>
          <tilt>75</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:Wait>
        <gx:duration>3</gx:duration>
      </gx:Wait>

      <!-- 2. 1950 OXFORD (centroid -122.2665495, 37.8728161, height 46.9m) -->
      <!-- Arrive 200m EAST of building, looking west -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2642695</longitude>
          <latitude>37.8728161</latitude>
          <altitude>95</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- 10s orbit clockwise: E->S (4 segments, 2.5s each) -->
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2665495</longitude>
          <latitude>37.8710141</latitude>
          <altitude>95</altitude>
          <heading>0</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2688295</longitude>
          <latitude>37.8728161</latitude>
          <altitude>95</altitude>
          <heading>90</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2665495</longitude>
          <latitude>37.8746181</latitude>
          <altitude>95</altitude>
          <heading>180</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2642695</longitude>
          <latitude>37.8728161</latitude>
          <altitude>95</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:Wait>
        <gx:duration>2</gx:duration>
      </gx:Wait>

      <!-- 3. 2200 BANCROFT (centroid -122.2655379, 37.8675063, height 77.1m) -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2632579</longitude>
          <latitude>37.8675063</latitude>
          <altitude>125</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2655379</longitude>
          <latitude>37.8657043</latitude>
          <altitude>125</altitude>
          <heading>0</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2678179</longitude>
          <latitude>37.8675063</latitude>
          <altitude>125</altitude>
          <heading>90</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2655379</longitude>
          <latitude>37.8693083</latitude>
          <altitude>125</altitude>
          <heading>180</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2632579</longitude>
          <latitude>37.8675063</latitude>
          <altitude>125</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:Wait>
        <gx:duration>2</gx:duration>
      </gx:Wait>

      <!-- 4. 2556 HASTE (North main centroid -122.2573102, 37.8660373, height 40.2m) -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2550302</longitude>
          <latitude>37.8660373</latitude>
          <altitude>90</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2573102</longitude>
          <latitude>37.8642353</latitude>
          <altitude>90</altitude>
          <heading>0</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2595902</longitude>
          <latitude>37.8660373</latitude>
          <altitude>90</altitude>
          <heading>90</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2573102</longitude>
          <latitude>37.8678393</latitude>
          <altitude>90</altitude>
          <heading>180</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>2.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2550302</longitude>
          <latitude>37.8660373</latitude>
          <altitude>90</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:Wait>
        <gx:duration>2</gx:duration>
      </gx:Wait>

      <!-- 5. 2400 BOWDITCH (North tower centroid -122.2569060, 37.8669718, height 85.3m) -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2546260</longitude>
          <latitude>37.8669718</latitude>
          <altitude>140</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Pull up 200ft (61m) AND flatten camera to near-horizontal, still looking west -->
      <gx:FlyTo>
        <gx:duration>3</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2546260</longitude>
          <latitude>37.8669718</latitude>
          <altitude>201</altitude>
          <heading>270</heading>
          <tilt>85</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:Wait>
        <gx:duration>3</gx:duration>
      </gx:Wait>

    </gx:Playlist>
  </gx:Tour>
</Document>
</kml>
