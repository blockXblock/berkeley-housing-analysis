<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2">
  <Document>
    <name>Berkeley Housing Pipeline - 45 Second Flyover</name>

    <gx:Tour>
      <name>Berkeley Housing Pipeline - 3D Skyline Tour</name>
      <gx:Playlist>

        <!-- Downtown approach -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>bounce</gx:flyToMode>
          <LookAt>
            <longitude>-122.26854</longitude>
            <latitude>37.86823</latitude>
            <altitude>0</altitude>
            <heading>20</heading>
            <tilt>78</tilt>
           <range>500</range> 
	   <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Downtown rotation -->
        <gx:FlyTo>
          <gx:duration>5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.26854</longitude>
            <latitude>37.86823</latitude>
            <altitude>0</altitude>
            <heading>140</heading>
            <tilt>77777778</tilt>
            <range>800</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.26854</longitude>
            <latitude>37.86823</latitude>
            <altitude>0</altitude>
            <heading>270</heading>
            <tilt>78</tilt>
            <range>650</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Fly to Telegraph / Durant -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.25829</longitude>
            <latitude>37.86524</latitude>
            <altitude>0</altitude>
            <heading>315</heading>
            <tilt>70</tilt>
            <range>540</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Telegraph / Durant rotation -->
        <gx:FlyTo>
          <gx:duration>7.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.25829</longitude>
            <latitude>37.86524</latitude>
            <altitude>0</altitude>
            <heading>80</heading>
            <tilt>70</tilt>
            <range>1000</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>3.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.25829</longitude>
            <latitude>37.86524</latitude>
            <altitude>0</altitude>
            <heading>210</heading>
            <tilt>70</tilt>
            <range>300</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Shattuck corridor from Ashby toward Cedar -->
        <gx:FlyTo>
          <gx:duration>4.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.26782</longitude>
            <latitude>37.85890</latitude>
            <altitude>0</altitude>
            <heading>350</heading>
            <tilt>72</tilt>
            <range>800</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>5.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.26782</longitude>
            <latitude>37.87280</latitude>
            <altitude>0</altitude>
            <heading>350</heading>
            <tilt>72</tilt>
            <range>800</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Shattuck rotation -->
        <gx:FlyTo>
          <gx:duration>4.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.26782</longitude>
            <latitude>37.86593</latitude>
            <altitude>0</altitude>
            <heading>110</heading>
            <tilt>70</tilt>
            <range>600</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Pull back to citywide skyline -->
        <gx:FlyTo>
          <gx:duration>4.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.26790</longitude>
            <latitude>37.86870</latitude>
            <altitude>0</altitude>
            <heading>320</heading>
            <tilt>62</tilt>
            <range>1200</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Citywide rotation -->
        <gx:FlyTo>
          <gx:duration>14.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.26790</longitude>
            <latitude>37.86870</latitude>
            <altitude>0</altitude>
            <heading>80</heading>
            <tilt>62</tilt>
            <range>800</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>4.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.26790</longitude>
            <latitude>37.86870</latitude>
            <altitude>0</altitude>
            <heading>210</heading>
            <tilt>62</tilt>
            <range>2200</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

      </gx:Playlist>
    </gx:Tour>
  </Document>
</kml>

