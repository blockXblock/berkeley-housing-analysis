<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2">
  <Document>
    <name>Berkeley Overview Tour</name>

    <gx:Tour>
      <name>15 Second Berkeley Flyover</name>
      <gx:Playlist>

        <!-- Arrive over Downtown Berkeley -->
        <gx:FlyTo>
          <gx:duration>2.0</gx:duration>
          <gx:flyToMode>bounce</gx:flyToMode>
          <LookAt>
            <longitude>-122.2682</longitude>
            <latitude>37.8701</latitude>
            <altitude>0</altitude>
            <heading>0</heading>
            <tilt>68</tilt>
            <range>1300</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Rotate over Downtown -->
        <gx:FlyTo>
          <gx:duration>2.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.2682</longitude>
            <latitude>37.8701</latitude>
            <altitude>0</altitude>
            <heading>120</heading>
            <tilt>68</tilt>
            <range>1300</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>2.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.2682</longitude>
            <latitude>37.8701</latitude>
            <altitude>0</altitude>
            <heading>240</heading>
            <tilt>68</tilt>
            <range>1300</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Fly southeast to Telegraph & Durant -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.2597</longitude>
            <latitude>37.8676</latitude>
            <altitude>0</altitude>
            <heading>300</heading>
            <tilt>70</tilt>
            <range>900</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <!-- Rotate over Telegraph & Durant -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.2597</longitude>
            <latitude>37.8676</latitude>
            <altitude>0</altitude>
            <heading>60</heading>
            <tilt>70</tilt>
            <range>900</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.2597</longitude>
            <latitude>37.8676</latitude>
            <altitude>0</altitude>
            <heading>180</heading>
            <tilt>70</tilt>
            <range>900</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

      </gx:Playlist>
    </gx:Tour>
  </Document>
</kml>

