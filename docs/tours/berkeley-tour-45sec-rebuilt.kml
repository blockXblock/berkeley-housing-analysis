            <altitude>220</altitude>
            <heading>192</heading>
            <tilt>80</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>6.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2686</longitude>
            <latitude>37.8552</latitude>
            <altitude>260</altitude>
            <heading>350</heading>
            <tilt>77</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>6.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2685</longitude>
            <latitude>37.8769</latitude>
            <altitude>280</altitude>
            <heading>6</heading>
            <tilt>77</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

