<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2">
  <Document>
    <name>Berkeley Housing Pipeline - Telegraph Shattuck Cedar Tour</name>
    <open>1</open>
    <gx:Tour>
      <name>Berkeley Housing Pipeline - Telegraph Shattuck Cedar Tour</name>
      <gx:Playlist>

        <gx:FlyTo>
          <gx:duration>6.0</gx:duration>
          <gx:flyToMode>bounce</gx:flyToMode>
          <Camera>
            <longitude>-122.2732</longitude>
            <latitude>37.8690</latitude>
            <altitude>280</altitude>
            <heading>78</heading>
            <tilt>78</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>4.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2623</longitude>
            <latitude>37.8652</latitude>
            <altitude>240</altitude>
            <heading>112</heading>
            <tilt>81</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- clockwise rotation at Telegraph/Durant -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2598</longitude>
            <latitude>37.8656</latitude>
            <altitude>230</altitude>
            <heading>155</heading>
            <tilt>81</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2598</longitude>
            <latitude>37.8656</latitude>
            <altitude>230</altitude>
            <heading>235</heading>
            <tilt>81</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2598</longitude>
            <latitude>37.8656</latitude>
            <altitude>230</altitude>
            <heading>315</heading>
            <tilt>81</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:Wait>
          <gx:duration>5.0</gx:duration>
        </gx:Wait>

        <!-- move south of Ashby and Shattuck, descend to 600 ft -->
        <gx:FlyTo>
          <gx:duration>4.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2686</longitude>
            <latitude>37.8539</latitude>
            <altitude>182.88</altitude>
            <heading>350</heading>
            <tilt>78</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- follow Shattuck midline north to Cedar -->
        <gx:FlyTo>
          <gx:duration>6.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2685</longitude>
            <latitude>37.8772</latitude>
            <altitude>182.88</altitude>
            <heading>358</heading>
            <tilt>78</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- rotate to look south -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2685</longitude>
            <latitude>37.8772</latitude>
            <altitude>182.88</altitude>
            <heading>178</heading>
            <tilt>76</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <gx:Wait>
          <gx:duration>10.0</gx:duration>
        </gx:Wait>

        <!-- finish west of Shattuck and Center, looking east -->
        <gx:FlyTo>
          <gx:duration>4.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2733</longitude>
            <latitude>37.8701</latitude>
            <altitude>220</altitude>
            <heading>90</heading>
            <tilt>79</tilt>
            <roll>0</roll>
            <altitudeMode>absolute</altitudeMode>
          </Camera>
        </gx:FlyTo>

      </gx:Playlist>
    </gx:Tour>
  </Document>
</kml>
