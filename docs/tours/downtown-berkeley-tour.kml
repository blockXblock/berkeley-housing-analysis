<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2">
  <Document>
    <name>Downtown Berkeley Overview Tour</name>

    <gx:Tour>
      <name>10 Second Downtown Berkeley Flyover</name>
      <gx:Playlist>

        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>bounce</gx:flyToMode>
          <LookAt>
            <longitude>-122.2682</longitude>
            <latitude>37.8701</latitude>
            <altitude>0</altitude>
            <heading>0</heading>
            <tilt>65</tilt>
            <range>1400</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.2682</longitude>
            <latitude>37.8701</latitude>
            <altitude>0</altitude>
            <heading>90</heading>
            <tilt>65</tilt>
            <range>1400</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.2682</longitude>
            <latitude>37.8701</latitude>
            <altitude>0</altitude>
            <heading>180</heading>
            <tilt>65</tilt>
            <range>1400</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

        <gx:FlyTo>
          <gx:duration>2.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>-122.2682</longitude>
            <latitude>37.8701</latitude>
            <altitude>0</altitude>
            <heading>270</heading>
            <tilt>65</tilt>
            <range>1400</range>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>

      </gx:Playlist>
    </gx:Tour>
  </Document>
</kml>

