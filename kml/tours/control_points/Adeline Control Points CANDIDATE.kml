<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2">
<Document>
	<name>Adeline Control Points CANDIDATE</name>
	<description><![CDATA[CANDIDATES ONLY — generated by scripts/gen_tour_control_points.py.
Drag each point onto the true centreline of Adeline in Google Earth Pro, add points where the
street bends, delete any that are wrong, then save over this file. Order is N->S — the flight follows
this order, so reordering the placemarks reorders the flight.]]></description>
	<Style id="s_ylw-pushpin"><IconStyle><scale>1.1</scale>
		<Icon><href>http://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon>
		<hotSpot x="20" y="2" xunits="pixels" yunits="pixels"/></IconStyle></Style>
	<StyleMap id="m_ylw-pushpin">
		<Pair><key>normal</key><styleUrl>#s_ylw-pushpin</styleUrl></Pair>
		<Pair><key>highlight</key><styleUrl>#s_ylw-pushpin</styleUrl></Pair></StyleMap>
	<Folder><name>Adeline Control Points</name><open>1</open>
	<Placemark>
		<name>Adeline-CP01</name>
		<description><![CDATA[CANDIDATE control point 1 of 6 · CORRIDOR END ANCHOR (approximate — drag onto the real endpoint) · DRAG ME onto the true street centreline · cruise 20 m]]></description>
		<styleUrl>#m_ylw-pushpin</styleUrl>
		<Point><gx:drawOrder>1</gx:drawOrder>
			<coordinates>-122.2683000000000,37.8607000000000,0</coordinates></Point>
	</Placemark>
	<Placemark>
		<name>Adeline-CP02</name>
		<description><![CDATA[CANDIDATE control point 2 of 6 · median longitude of 2 housing points in this latitude band · DRAG ME onto the true street centreline · cruise 20 m]]></description>
		<styleUrl>#m_ylw-pushpin</styleUrl>
		<Point><gx:drawOrder>1</gx:drawOrder>
			<coordinates>-122.2681024913782,37.8552207960853,0</coordinates></Point>
	</Placemark>
	<Placemark>
		<name>Adeline-CP03</name>
		<description><![CDATA[CANDIDATE control point 3 of 6 · median longitude of 1 housing points in this latitude band · DRAG ME onto the true street centreline · cruise 20 m]]></description>
		<styleUrl>#m_ylw-pushpin</styleUrl>
		<Point><gx:drawOrder>1</gx:drawOrder>
			<coordinates>-122.2689405000000,37.8529388543467,0</coordinates></Point>
	</Placemark>
	<Placemark>
		<name>Adeline-CP04</name>
		<description><![CDATA[CANDIDATE control point 4 of 6 · median longitude of 1 housing points in this latitude band · DRAG ME onto the true street centreline · cruise 20 m]]></description>
		<styleUrl>#m_ylw-pushpin</styleUrl>
		<Point><gx:drawOrder>1</gx:drawOrder>
			<coordinates>-122.2692030000000,37.8506569126080,0</coordinates></Point>
	</Placemark>
	<Placemark>
		<name>Adeline-CP05</name>
		<description><![CDATA[CANDIDATE control point 5 of 6 · median longitude of 6 housing points in this latitude band · DRAG ME onto the true street centreline · cruise 20 m]]></description>
		<styleUrl>#m_ylw-pushpin</styleUrl>
		<Point><gx:drawOrder>1</gx:drawOrder>
			<coordinates>-122.2696670000000,37.8483749708693,0</coordinates></Point>
	</Placemark>
	<Placemark>
		<name>Adeline-CP06</name>
		<description><![CDATA[CANDIDATE control point 6 of 6 · CORRIDOR END ANCHOR (approximate — drag onto the real endpoint) · DRAG ME onto the true street centreline · cruise 20 m]]></description>
		<styleUrl>#m_ylw-pushpin</styleUrl>
		<Point><gx:drawOrder>1</gx:drawOrder>
			<coordinates>-122.2726000000000,37.8408000000000,0</coordinates></Point>
	</Placemark>
	</Folder>
</Document>
</kml>
