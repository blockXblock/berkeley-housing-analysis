	<Folder><name>Adeline Control Points</name><open>1</open>
	<Placemark>
		<name>Adeline-CP01</name>
		<description><![CDATA[DERIVED from the gap between the parcel rows facing Adeline
(midpoint of west-parcel east edge and east-parcel west edge, rolling-median smoothed).
Accurate to a few metres. Check once in Earth Pro before a final recording.]]></description>
		<styleUrl>#m_ylw-pushpin</styleUrl>
		<Point><gx:drawOrder>1</gx:drawOrder><coordinates>-122.2679770326285,37.8588249999999,0</coordinates></Point>
	</Placemark>
