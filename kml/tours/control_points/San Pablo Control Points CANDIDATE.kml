<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2">
<Document>
	<name>San Pablo Control Points CANDIDATE</name>
	<description><![CDATA[CANDIDATES ONLY — generated by scripts/gen_tour_control_points.py.
Drag each point onto the true centreline of San Pablo in Google Earth Pro, add points where the
street bends, delete any that are wrong, then save over this file. Order is N->S — the flight follows
this order, so reordering the placemarks reorders the flight.]]></description>
	<Style id="s_ylw-pushpin"><IconStyle><scale>1.1</scale>
		<Icon><href>http://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon>
		<hotSpot x="20" y="2" xunits="pixels" yunits="pixels"/></IconStyle></Style>
	<StyleMap id="m_ylw-pushpin">
		<Pair><key>normal</key><styleUrl>#s_ylw-pushpin</styleUrl></Pair>
		<Pair><key>highlight</key><styleUrl>#s_ylw-pushpin</styleUrl></Pair></StyleMap>
	<Folder><name>San Pablo Control Points</name><open>1</open>
	<Placemark>
		<name>SanPablo-CP01</name>
		<description><![CDATA[CANDIDATE control point 1 of 8 · CORRIDOR END ANCHOR (approximate — drag onto the real endpoint) · DRAG ME onto the true street centreline · cruise 20 m]]></description>
		<styleUrl>#m_ylw-pushpin</styleUrl>
		<Point><gx:drawOrder>1</gx:drawOrder>
			<coordinates>-122.2976000000000,37.8878000000000,0</coordinates></Point>
	</Placemark>
	<Placemark>
		<name>SanPablo-CP02</name>
		<description><![CDATA[CANDIDATE control point 2 of 8 · median longitude of 12 housing points in this latitude band · DRAG ME onto the true street centreline · cruise 20 m]]></description>
