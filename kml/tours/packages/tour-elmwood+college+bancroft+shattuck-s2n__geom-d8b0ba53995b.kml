<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2" xmlns:kml="http://www.opengis.net/kml/2.2" xmlns:atom="http://www.w3.org/2005/Atom">
<Document>
<!-- TOUR PACKAGE (generated by scripts/build_tour_package.py — do not hand-edit)
     tour:     kml/tours/tour-elmwood+college+bancroft+shattuck-s2n.kml
     geometry: kml/geometry/geometry.kml sha256:d8b0ba53995b placemarks:392 -->
<gx:Tour>
      <name>Elmwood-Bancroft-Shattuck Tour</name>
      <gx:Playlist>

        <!-- 1. Start: 60m above Elmwood Theater, facing NNW -->
        <gx:FlyTo>
          <gx:duration>2.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.25298842534337</longitude>
            <latitude>37.85633001834821</latitude>
            <altitude>60</altitude>
            <heading>350</heading>
            <tilt>80</tilt>
            <roll>0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 2. Hold 5 seconds at 60m for GE to preload imagery -->
        <gx:Wait>
          <gx:duration>5.0</gx:duration>
        </gx:Wait>

        <!-- 3. Drop to 10m for theater front shot -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.25298842534337</longitude>
            <latitude>37.85633001834821</latitude>
            <altitude>10</altitude>
            <heading>350</heading>
            <tilt>80</tilt>
            <roll>0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 4. Hold 4 seconds at 10m - theater money shot -->
        <gx:Wait>
          <gx:duration>4.0</gx:duration>
        </gx:Wait>

        <!-- 5. Rise to 60m + rotate to 315 for College Ave -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.25298842534337</longitude>
            <latitude>37.85633001834821</latitude>
            <altitude>60</altitude>
            <heading>315</heading>
            <tilt>80</tilt>
            <roll>0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 6. Fly north along College Ave to Bancroft Way -->
        <gx:FlyTo>
          <gx:duration>15.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2540</longitude>
            <latitude>37.8693</latitude>
            <altitude>40</altitude>
            <heading>315</heading>
            <tilt>80</tilt>
            <roll>0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 7. Rotate 45° CCW (heading 315 -> 270) + rise 20m -->
        <gx:FlyTo>
          <gx:duration>3.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2540</longitude>
            <latitude>37.8693</latitude>
            <altitude>60</altitude>
            <heading>270</heading>
            <tilt>80</tilt>
            <roll>0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 8. Hold 3 seconds, now facing west at Bancroft -->
        <gx:Wait>
          <gx:duration>3.0</gx:duration>
        </gx:Wait>

        <!-- 9. Fly west along Bancroft to Shattuck -->
        <gx:FlyTo>
          <gx:duration>10.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2680</longitude>
            <latitude>37.8694</latitude>
            <altitude>60</altitude>
            <heading>270</heading>
            <tilt>80</tilt>
            <roll>0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 10. Hold 3 seconds at Shattuck -->
        <gx:Wait>
          <gx:duration>3.0</gx:duration>
        </gx:Wait>

        <!-- 11. Rotate 180° (heading 270 -> 90, looking east back along path) -->
        <gx:FlyTo>
          <gx:duration>5.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2680</longitude>
            <latitude>37.8694</latitude>
            <altitude>60</altitude>
            <heading>90</heading>
            <tilt>80</tilt>
            <roll>0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 12. Pull back and up, widen shot -->
        <gx:FlyTo>
          <gx:duration>5.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <Camera>
            <longitude>-122.2730</longitude>      <!-- west of Shattuck -->
            <latitude>37.8694</latitude>
            <altitude>250</altitude>              <!-- up from 60m -->
            <heading>90</heading>
            <tilt>65</tilt>                       <!-- slightly less tilt for wider feel -->
            <roll>0</roll>
            <altitudeMode>relativeToGround</altitudeMode>
          </Camera>
        </gx:FlyTo>

        <!-- 13. Hold 3 seconds on wide shot -->
        <gx:Wait>
          <gx:duration>3.0</gx:duration>
        </gx:Wait>

      </gx:Playlist>
    </gx:Tour>
