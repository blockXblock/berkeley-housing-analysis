<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2">
<Document>
  <name>Berkeley Large Housing Projects Tour (slow)</name>
  <description>Orbit tour of 17 private housing projects with over 200 units</description>
  
  
  <gx:Tour>
    <name>Large Projects Orbit Tour (slow)</name>
    <gx:Playlist>
    <!-- Opening NE campus establishing shot -->
    <!-- 1. Opening: 200m east of Campanile, 95m AGL, looking west.
          Campanile (-122.2578, 37.8723) is the foreground subject. -->
