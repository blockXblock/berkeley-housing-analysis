<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2">
<Document>
  <name>UC Berkeley Dormitory Tour v3</name>
  <description>
    A tour of UC Berkeley's largest student housing projects. Starts at
    the Campanile looking west across downtown, then visits four major
    dormitory projects: 1950 Oxford, 2200 Bancroft, 2556 Haste, and 2400
    Bowditch (Anna Head).

    At each stop, the camera approaches the building from the east side
    (200m east) looking west, then orbits the structure clockwise at 200m
    radius (East -> South -> West -> North -> East). A 2-second pause
    follows each orbit before the next flight. Final stop pulls up 200ft
    over 2400 Bowditch and holds.

    Coordinate offsets at Berkeley latitude ~37.87:
      200m N or S = 0.001802 degrees lat
      200m E or W = 0.002280 degrees lon

    Total runtime ~62 seconds.
  </description>

  <gx:Tour>
    <name>UC Berkeley Dormitory Tour</name>
    <gx:Playlist>

      <!-- 1. Establishing shot: Campanile, high view looking west at downtown -->
      <gx:FlyTo>
        <gx:duration>0</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2578</longitude>
          <latitude>37.8723</latitude>
          <altitude>400</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>absolute</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:Wait>
        <gx:duration>3</gx:duration>
      </gx:Wait>

      <!-- 2. 1950 OXFORD (centroid -122.2665495, 37.8728161, height 46.9m) -->
      <!-- Arrive 200m EAST of building, looking west -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2642695</longitude>
          <latitude>37.8728161</latitude>
          <altitude>95</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit clockwise: E->S (looking north) -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2665495</longitude>
          <latitude>37.8710141</latitude>
          <altitude>95</altitude>
          <heading>0</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit: S->W (looking east) -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2688295</longitude>
          <latitude>37.8728161</latitude>
          <altitude>95</altitude>
          <heading>90</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit: W->N (looking south) -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2665495</longitude>
          <latitude>37.8746181</latitude>
          <altitude>95</altitude>
          <heading>180</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit: N->E (looking west, back to start) -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2642695</longitude>
          <latitude>37.8728161</latitude>
          <altitude>95</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Pause 2s before next flight -->
      <gx:Wait>
        <gx:duration>2</gx:duration>
      </gx:Wait>

      <!-- 3. 2200 BANCROFT (centroid -122.2655379, 37.8675063, height 77.1m) -->
      <!-- Arrive 200m EAST of building, looking west -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2632579</longitude>
          <latitude>37.8675063</latitude>
          <altitude>125</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit: E->S -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2655379</longitude>
          <latitude>37.8657043</latitude>
          <altitude>125</altitude>
          <heading>0</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit: S->W -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2678179</longitude>
          <latitude>37.8675063</latitude>
          <altitude>125</altitude>
          <heading>90</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit: W->N -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2655379</longitude>
          <latitude>37.8693083</latitude>
          <altitude>125</altitude>
          <heading>180</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit: N->E -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2632579</longitude>
          <latitude>37.8675063</latitude>
          <altitude>125</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Pause 2s -->
      <gx:Wait>
        <gx:duration>2</gx:duration>
      </gx:Wait>

      <!-- 4. 2556 HASTE (North main centroid -122.2573102, 37.8660373, height 40.2m) -->
      <!-- Arrive 200m EAST of building, looking west -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2550302</longitude>
          <latitude>37.8660373</latitude>
          <altitude>90</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit: E->S -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2573102</longitude>
          <latitude>37.8642353</latitude>
          <altitude>90</altitude>
          <heading>0</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit: S->W -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2595902</longitude>
          <latitude>37.8660373</latitude>
          <altitude>90</altitude>
          <heading>90</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit: W->N -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2573102</longitude>
          <latitude>37.8678393</latitude>
          <altitude>90</altitude>
          <heading>180</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Orbit: N->E -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2550302</longitude>
          <latitude>37.8660373</latitude>
          <altitude>90</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Pause 2s -->
      <gx:Wait>
        <gx:duration>2</gx:duration>
      </gx:Wait>

      <!-- 5. 2400 BOWDITCH (North tower centroid -122.2569060, 37.8669718, height 85.3m) -->
      <!-- Arrive 200m EAST of building, looking west -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2546260</longitude>
          <latitude>37.8669718</latitude>
          <altitude>140</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Pull up 200ft (~61m) - rise from 140m to 201m, keep position E of building -->
      <gx:FlyTo>
        <gx:duration>3</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2546260</longitude>
          <latitude>37.8669718</latitude>
          <altitude>201</altitude>
          <heading>270</heading>
          <tilt>60</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:Wait>
        <gx:duration>3</gx:duration>
      </gx:Wait>

    </gx:Playlist>
  </gx:Tour>
</Document>
</kml>
