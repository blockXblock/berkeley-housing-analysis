<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2">
<Document>
  <name>UC Berkeley Dormitory Tour</name>
  <description>
    A tour of UC Berkeley's largest student housing projects in the
    Berkeley Housing Pipeline. Starts at the Campanile looking west
    across downtown, then visits four major dormitory projects:
    1950 Oxford, 2200 Bancroft, 2556 Haste, and 2400 Bowditch (Anna Head).
    Each interior stop includes a 6-second 360-degree orbit. Final stop
    pulls up 200 feet over 2400 Bowditch and holds.
  </description>

  <gx:Tour>
    <name>UC Berkeley Dormitory Tour</name>
    <gx:Playlist>

      <!-- 1. Establishing shot: Campanile, high view looking west at downtown -->
      <gx:FlyTo>
        <gx:duration>0</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2578</longitude>
          <latitude>37.8723</latitude>
          <altitude>400</altitude>
          <heading>270</heading>
          <tilt>70</tilt>
          <altitudeMode>absolute</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:Wait>
        <gx:duration>3</gx:duration>
      </gx:Wait>

      <!-- 2. Fly to 1950 Oxford (heading 0, north-facing approach) -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2665495</longitude>
          <latitude>37.8728161</latitude>
          <altitude>95</altitude>
          <heading>0</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- 360 orbit: 1950 Oxford, 6 seconds total, 4 segments of 1.5s -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2665495</longitude>
          <latitude>37.8728161</latitude>
          <altitude>95</altitude>
          <heading>90</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2665495</longitude>
          <latitude>37.8728161</latitude>
          <altitude>95</altitude>
          <heading>180</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2665495</longitude>
          <latitude>37.8728161</latitude>
          <altitude>95</altitude>
          <heading>270</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2665495</longitude>
          <latitude>37.8728161</latitude>
          <altitude>95</altitude>
          <heading>360</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>

      <!-- 3. Fly to 2200 Bancroft -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2655379</longitude>
          <latitude>37.8675063</latitude>
          <altitude>125</altitude>
          <heading>0</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- 360 orbit: 2200 Bancroft -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2655379</longitude>
          <latitude>37.8675063</latitude>
          <altitude>125</altitude>
          <heading>90</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2655379</longitude>
          <latitude>37.8675063</latitude>
          <altitude>125</altitude>
          <heading>180</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2655379</longitude>
          <latitude>37.8675063</latitude>
          <altitude>125</altitude>
          <heading>270</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2655379</longitude>
          <latitude>37.8675063</latitude>
          <altitude>125</altitude>
          <heading>360</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>

      <!-- 4. Fly to 2556 Haste (North main polygon) -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2573102</longitude>
          <latitude>37.8660373</latitude>
          <altitude>90</altitude>
          <heading>0</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- 360 orbit: 2556 Haste -->
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2573102</longitude>
          <latitude>37.8660373</latitude>
          <altitude>90</altitude>
          <heading>90</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2573102</longitude>
          <latitude>37.8660373</latitude>
          <altitude>90</altitude>
          <heading>180</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2573102</longitude>
          <latitude>37.8660373</latitude>
          <altitude>90</altitude>
          <heading>270</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:FlyTo>
        <gx:duration>1.5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2573102</longitude>
          <latitude>37.8660373</latitude>
          <altitude>90</altitude>
          <heading>360</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>

      <!-- 5. Fly to 2400 Bowditch (Anna Head North tower) -->
      <gx:FlyTo>
        <gx:duration>5</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2569060</longitude>
          <latitude>37.8669718</latitude>
          <altitude>140</altitude>
          <heading>0</heading>
          <tilt>65</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <!-- Pull up 200ft (~61m) over 2400 Bowditch (final shot) -->
      <gx:FlyTo>
        <gx:duration>3</gx:duration>
        <gx:flyToMode>smooth</gx:flyToMode>
        <Camera>
          <longitude>-122.2569060</longitude>
          <latitude>37.8669718</latitude>
          <altitude>201</altitude>
          <heading>0</heading>
          <tilt>45</tilt>
          <altitudeMode>relativeToGround</altitudeMode>
        </Camera>
      </gx:FlyTo>
      <gx:Wait>
        <gx:duration>3</gx:duration>
      </gx:Wait>

    </gx:Playlist>
  </gx:Tour>
</Document>
</kml>
